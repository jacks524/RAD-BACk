# Chemin du disque externe contenant les donnees tolerantes au NTFS.
# Exemple: /media/<user>/Familia/Camrail-Challenge/kalati-data
KALATI_DATA=./data

RDA_ENV=developpement
RDA_SECRET_JWT=changez-moi-en-production
RDA_ORIGINES_CORS=http://localhost:8080,http://localhost:8081

RDA_DB_CORPUS_URL=postgresql+asyncpg://rda_corpus_app:rda_corpus_app@rda-db-corpus:5432/rda_corpus
RDA_DB_CORPUS_INGESTION_URL=postgresql+asyncpg://rda_corpus_ingestion:rda_corpus_ingestion@rda-db-corpus:5432/rda_corpus
RDA_DB_IDENTITE_URL=postgresql+asyncpg://rda_identite_app:rda_identite_app@rda-db-identite:5432/rda_identite
RDA_DB_INTELLIGENCE_URL=postgresql+asyncpg://rda_intelligence_app:rda_intelligence_app@rda-db-intelligence:5432/rda_intelligence

RDA_REDIS_URL=redis://rda-donnees:6379/0
RDA_MINIO_ENDPOINT=rda-donnees:9000
RDA_MINIO_ACCESS_KEY=minio
RDA_MINIO_SECRET_KEY=minio123
RDA_MINIO_BUCKET=kalati
RDA_MINIO_SECURE=false

RDA_INFERENCE_URL=http://rda-inference:8080
RDA_ARTEFACTS_DIR=/app/artefacts
KALATI_DATA=/media/jacquy-ngonga4/Familia/Camrail-Challenge/kalati-data
# ============================================================================
#  Module RA — maintenance par realite augmentee
# ============================================================================

# Racine des donnees du module sur le disque externe (artefacts, modeles, cache HF, photos).
RA_DATA=/mnt/kalati/RDA/rda-data

# --- service ra-vision (llama.cpp, Qwen2.5-VL-3B) ---------------------------
RA_VISION_MODELE=qwen2.5-vl-3b-instruct-q4_k_m.gguf
RA_VISION_MMPROJ=mmproj-Qwen2.5-VL-3B-Instruct-f16.gguf
RA_VISION_THREADS=4
RA_VISION_CTX=16384
RA_VISION_MEMOIRE=6g

# --- service ra-encodeurs ---------------------------------------------------
# RA_MODELE_TEXTE doit etre le modele qui a produit embeddings_texte.npy.
# Le chargeur le verifie (cosinus >= 0,99) et refuse de demarrer sinon.
RA_MODELE_TEXTE=intfloat/multilingual-e5-base
RA_MODELE_VISUEL=google/siglip2-base-patch16-384
RA_MODELE_RECLASSEUR=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RA_THREADS_TORCH=4
RA_ENCODEURS_MEMOIRE=5g

# --- vu depuis l'API --------------------------------------------------------
RDA_RA_ACTIF=true
RDA_RA_VISION_URL=http://ra-vision:8080
RDA_RA_ENCODEURS_URL=http://ra-encodeurs:8082
RDA_RA_ARTEFACTS_DIR=/ra-data/artefacts
RDA_RA_DEPOT_DIR=/ra-data/uploads
RDA_RA_MINIO_BUCKET=ra-images

# Delais d'attente, secondes. Une reponse avec image sur CPU prend plusieurs dizaines
# de secondes : ces valeurs sont larges a dessein.
RDA_RA_DELAI_VISION=900
RDA_RA_DELAI_LOCALISATION=600
RDA_RA_DELAI_ENCODEURS=30

# Taille et formats acceptes pour les photos versees par les techniciens.
RDA_RA_TAILLE_MAX_PHOTO_MO=10

# --- client mobile Capacitor ------------------------------------------------
# Remplacer <IP-LAN> par l'adresse de la machine sur le reseau local (ip -4 addr).
RDA_ORIGINES_CORS=http://localhost:8080,http://localhost:8081,https://localhost,http://localhost,capacitor://localhost,http://localhost:5173

# --- comptes de test du module (scripts/creer_comptes_test_ra.py) -----------
RDA_RA_MDP_TECHNICIEN_DMAT=changez-moi
RDA_RA_MDP_TECHNICIEN_DIF=changez-moi
RDA_RA_MDP_SECURITE=changez-moi
